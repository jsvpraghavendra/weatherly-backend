# Weatherly Backend Environment Configuration

# Server listening port (Render sets this automatically; defaults to 8080 locally)
PORT=8080

# CORS allowed origins (comma-separated; include your deployed frontend URL and local dev origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://*.onrender.com

# Weather Provider Configuration (Open-Meteo)
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Optional Open-Meteo commercial API key (leave empty for free public tier)
WEATHER_API_KEY=

# HTTP client configuration
WEATHER_USER_AGENT=Weatherly/1.0 (https://github.com/jsvpraghavendra/weatherly-backend)
WEATHER_CONNECT_TIMEOUT_MS=5000
WEATHER_READ_TIMEOUT_MS=8000
